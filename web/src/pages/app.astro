            '<li>Pick the <b>projects</b> folder, or a single project inside it.</li>',
          openPicker: 'Open the file picker →',
          cancel: 'Cancel',
          copy: 'copy',
          copied: 'copied',
          copyTitle: 'Copy the path',
          noMainJsonl: 'No main .jsonl transcript found in the selection.',
          replayMainOnly:
            'replaying {name} · main agent only — drop its <uuid>/ folder too to see the subagents it spawned',
          replaying: 'replaying {name} · {n} subagent{s}',
          liveReplaying: 'live · {name} · {n} subagent{s}',
          openingPicker: 'opening the file picker…',
          folderDenied:
            'Couldn\'t open that folder. In the dialog, use ⌘⇧G and go to ~/.claude/projects.',
