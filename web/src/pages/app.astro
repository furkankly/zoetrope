---
// The in-browser zoetrope app — a standalone full-screen page (NOT a Starlight
// docs route). It loads the WebAssembly build (the Rust `web` bin, compiled by
// `pnpm build:wasm` into /public/wasm) which boots into the bundled demo, then
// lets you replay your own transcript or — in Chromium — open a session folder
// and follow it live. Everything runs locally; nothing is uploaded.
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import Schema from '../components/Schema.astro';
import { REPO_URL } from '../consts.ts';
const wasmBase = '/wasm';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>zoetrope — browser app</title>
    <meta
      name="description"
      content="Run zoetrope in your browser: replay a Claude Code session transcript as a live flow graph, fully locally."
    />
    <Schema />
    <Seo
      title="zoetrope — browser app"
      description="Run zoetrope in your browser: replay a Claude Code session transcript as a live flow graph, fully locally."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Same self-hosted brand fonts as the landing (Space Mono for the wordmark,
         JetBrains Mono for UI text), so the top bar reads identically across pages. -->
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-display" preload />
    <!-- Resolve the wasm's libm `env` imports (fmod/round/critical-section) to the
         JS shim copied next to the wasm. Must precede the module script below. -->
    <script type="importmap" is:inline>
      { "imports": { "env": "/wasm/env.js" } }
    </script>
    <style is:inline>
      :root {
        --gold: #d7af00;
        --gold-bright: #f0d56a;
        --green: #87d787;
        --ink: #121212;
        --panel: #1c1c1c;
        --dim: #585858;
        --bright: #e6e6e6;
        --mono: var(--font-mono), ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        --display: var(--font-display), var(--font-mono), ui-monospace, monospace;
      }
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        background-color: var(--panel);
        overflow: hidden;
        font-family: var(--mono);
        color: var(--bright);
      }
      /* Stack the toolbar above the canvas so neither overlaps the other. */
      body {
        display: flex;
        flex-direction: column;
      }
      /* The WebGl2 backend fills this — it takes the space left under the bar. */
      #terminal-container {
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        position: relative;
      }
      /* ratzilla makes the WebGl2 canvas focusable (tabindex="0") to capture keys,
         so the browser draws its default focus ring around the whole canvas on
         click/keypress. The canvas *is* the app — nothing to tab between inside it —
         so the ring is just noise. Drop it (the bar buttons/modals keep theirs). */
      #terminal-container:focus,
      #terminal-container:focus-visible,
      #terminal-container canvas:focus,
      #terminal-container canvas:focus-visible {
        outline: none;
      }

      /* ── Top toolbar ─────────────────────────────────────────────────── */
      .bar {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        background: var(--ink);
        border-bottom: 1px solid #2a2a2a;
        font-size: 0.8rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: var(--display);
        color: var(--bright);
        font-weight: 700;
        text-decoration: none;
        letter-spacing: -0.02em;
        white-space: nowrap;
      }
      .brand:hover {
        color: var(--gold-bright);
      }
      .brand-mark { flex: none; overflow: visible; }
      /* Carries the pulse for both brands. The header's `.glyph` is now the
         mark's centre circle, which takes its green from `fill` and only the
         animation from here; the mobile note's is still a text bullet and uses
         the `color`. */
      .brand .glyph {
        color: var(--green);
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
      .spacer {
        flex: 1;
      }
      button.act,
      label.act {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--bright);
        background: var(--panel);
        border: 1px solid #343434;
        border-radius: 6px;
        padding: 0.32rem 0.7rem;
        cursor: pointer;
        white-space: nowrap;
        transition: border-color 0.12s, color 0.12s, background 0.12s;
      }
      button.act:hover,
      label.act:hover {
        border-color: var(--gold);
        color: var(--gold-bright);
      }
      button.act.primary {
        border-color: var(--gold);
        color: #1a1500;
        background: var(--gold);
        font-weight: 600;
      }
      button.act.primary:hover {
        background: var(--gold-bright);
        border-color: var(--gold-bright);
      }
      button.act:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        border-color: #343434;
        color: var(--dim);
      }
      .link {
        color: var(--dim);
        text-decoration: none;
      }
      .link:hover {
        color: var(--bright);
      }

      /* ── Status text (lives in the top bar, next to the wordmark) ──────── */
      .statusbar {
        font-size: 0.74rem;
        color: var(--dim);
        max-width: min(48vw, 560px);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .statusbar .dot {
        color: var(--green);
      }
      .statusbar.err {
        color: #f0a0a0;
      }
      @media (max-width: 860px) {
        .statusbar { display: none; }
      }

      /* ── Drag overlay ────────────────────────────────────────────────── */
      .drop {
        position: fixed;
        inset: 0;
        z-index: 20;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(18, 18, 18, 0.82);
        border: 2px dashed var(--gold);
        color: var(--gold-bright);
        font-size: 1.1rem;
      }
      .drop.show {
        display: flex;
      }

      /* ── Mobile notice: the graph wants a desktop ──────────────────────── */
      .mnote { display: none; }
      @media (max-width: 700px) {
        .mnote {
          position: fixed;
          inset: 0;
          z-index: 60;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 1.5rem;
          background: rgba(13, 13, 13, 0.94);
        }
        .mnote.dismissed { display: none; }
      }
      .mnote-card {
        max-width: 22rem;
        background: var(--ink);
        border: 1px solid #343434;
        border-radius: 12px;
        padding: 1.3rem 1.35rem 1.4rem;
      }
      .mnote-brand {
        font-family: var(--display);
        font-weight: 700;
        color: var(--bright);
        margin-bottom: 0.7rem;
      }
      .mnote-brand .glyph { color: var(--green); }
      .mnote-card h2 {
        font-family: var(--display);
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        margin: 0 0 0.55rem;
        color: var(--gold-bright);
      }
      .mnote-card p {
        margin: 0 0 1.1rem;
        font-size: 0.86rem;
        line-height: 1.55;
        color: #b6b6b6;
      }
      .mnote-card button {
        width: 100%;
        font-family: var(--mono);
        font-size: 0.82rem;
        color: var(--bright);
        background: var(--panel);
        border: 1px solid #343434;
        border-radius: 7px;
        padding: 0.55rem 0.9rem;
        cursor: pointer;
        transition: border-color 0.12s, color 0.12s;
      }
      .mnote-card button:hover { border-color: var(--gold); color: var(--gold-bright); }

      /* ── Session picker modal ─────────────────────────────────────────── */
      .modal {
        position: fixed;
        inset: 0;
        z-index: 30;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(10, 10, 10, 0.78);
      }
      .modal.show {
        display: flex;
      }
      .modal-panel {
        width: min(92vw, 640px);
        max-height: 78vh;
        display: flex;
        flex-direction: column;
        background: var(--ink);
        border: 1px solid #343434;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55);
      }
      .modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 0.9rem;
        border-bottom: 1px solid #2a2a2a;
        font-size: 0.85rem;
        color: var(--gold-bright);
      }
      .modal-actions {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }
      .modal-link {
        background: none;
        border: none;
        color: var(--dim);
        cursor: pointer;
        font-family: var(--mono);
        font-size: 0.72rem;
      }
      .modal-link:hover {
        color: var(--gold-bright);
      }
      .modal-x {
        background: none;
        border: none;
        color: var(--dim);
        cursor: pointer;
        font-size: 0.9rem;
        font-family: var(--mono);
      }
      .modal-x:hover {
        color: var(--bright);
      }

      /* ── Pre-picker guidance modal ───────────────────────────────────── */
      .help-body {
        padding: 0.95rem 1.1rem 1.15rem;
        font-size: 0.85rem;
        line-height: 1.6;
      }
      .help-body p { margin: 0 0 0.6rem; }
      .help-dim { color: var(--dim); }
      .list-note {
        margin: 0 0 0.65rem;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: rgba(215, 175, 0, 0.05);
        color: var(--dim);
        font-size: 0.78rem;
        line-height: 1.5;
      }
      .help-body code {
        background: var(--panel);
        border: 1px solid #343434;
        border-radius: 5px;
        padding: 0.1rem 0.42rem;
        color: var(--gold-bright);
      }
      .copy-btn {
        margin-left: 0.45rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--dim);
        background: none;
        border: 1px solid #343434;
        border-radius: 5px;
        padding: 0.05rem 0.42rem;
        cursor: pointer;
        transition: color 0.12s, border-color 0.12s;
      }
      .copy-btn:hover { color: var(--bright); border-color: var(--gold); }
      .help-steps {
        margin: 0.5rem 0 1rem;
        padding-left: 1.25rem;
        color: var(--bright);
      }
      .help-steps li { margin: 0.3rem 0; }
      .help-body kbd {
        background: var(--panel);
        border: 1px solid #343434;
        border-bottom-width: 2px;
        border-radius: 4px;
        padding: 0.02rem 0.34rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--bright);
      }
      .help-actions { display: flex; gap: 0.6rem; }
      .session-list {
        overflow-y: auto;
        padding: 0.4rem;
      }
      .session-row {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        width: 100%;
        text-align: left;
        background: none;
        border: 1px solid transparent;
        border-radius: 7px;
        padding: 0.5rem 0.65rem;
        cursor: pointer;
        font-family: var(--mono);
        color: var(--bright);
      }
      .session-row:hover {
        background: var(--panel);
        border-color: #343434;
      }
      .session-row.live:hover {
        border-color: var(--green);
      }
      .s-title {
        font-size: 0.82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .s-meta {
        font-size: 0.7rem;
        color: var(--dim);
      }
      .s-meta .dot {
        color: var(--green);
      }
      .session-empty {
        padding: 1rem;
        color: var(--dim);
        font-size: 0.8rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="bar">
      {/* The mark, inlined and recomposed for 18px — the ring, the elapsed arc
          and the playhead; the session inside them is three grey pixels at this
          size and goes. The live agent stays as the centre dot and keeps the
          pulse the bare `●` carried, so the bar still reads as running. Same
          treatment as the landing header. */}
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
          <g fill="none" stroke-width="3.5" stroke-dasharray="5.8 2.84">
            <path d="M16 5 A 11 11 0 1 1 16 27 A 11 11 0 1 1 16 5" stroke="var(--dim)"></path>
            <path d="M16 5 A 11 11 0 0 1 25.5 21.5" stroke="var(--gold)" opacity="0.55"></path>
          </g>
          <line
            x1="16"
            y1="2.5"
            x2="16"
            y2="7"
            stroke="var(--gold)"
            stroke-width="2.6"
            stroke-linecap="round"
            transform="rotate(120 16 16)"></line>
          <circle class="glyph" cx="16" cy="16" r="2.6" fill="var(--green)"></circle>
        </svg>
        zoetrope
      </a>
      <span id="status" class="statusbar" data-i18n="loading">loading wasm…</span>
      <span class="spacer"></span>

      <button id="open-folder" class="act primary" title="Browse your Claude sessions and replay or follow one live." data-i18n-title="sessionsTitle" data-i18n="sessions">
        Sessions
      </button>
      <input id="dir-input" type="file" webkitdirectory hidden />

      <button id="reset" class="act" title="Reload the bundled demo session" data-i18n-title="demoTitle" data-i18n="demo">Demo</button>

      <button id="lang" class="act" title="Switch language / 切换语言">中文</button>

      <a class="link" href={REPO_URL} target="_blank" rel="noopener">GitHub ↗</a>
    </div>

    <div id="terminal-container"></div>

    <div id="drop" class="drop" data-i18n="dropHint">Drop a session's &lt;uuid&gt;.jsonl here (with its &lt;uuid&gt;/ folder for subagents) to replay it, or use “Sessions” to browse your Claude projects.</div>

    <!-- Small-screen heads-up: the graph is dense and needs a mouse/keyboard.
         Dismissable, so a curious phone visitor can still watch the replay. -->
    <div id="mobile-note" class="mnote">
      <div class="mnote-card">
        <div class="mnote-brand"><span class="glyph">●</span> zoetrope</div>
        <h2 data-i18n="mnoteTitle">Built for a bigger screen</h2>
        <p data-i18n="mnoteBody">The flow graph is dense and made for a larger display. Open zoetrope on a desktop to scrub, zoom, and load your own sessions.</p>
        <button id="mobile-note-dismiss" data-i18n="mnoteDismiss">Look around anyway</button>
      </div>
    </div>

    <div id="session-modal" class="modal">
      <div class="modal-panel">
        <div class="modal-head">
          <span id="session-head" data-i18n="pickSession">Pick a session</span>
          <span class="modal-actions">
            <button id="session-refolder" class="modal-link" title="Choose a different folder" data-i18n-title="refolderTitle" data-i18n="refolder">open a different folder…</button>
            <button id="session-close" class="modal-x" title="Close" data-i18n-title="closeTitle">✕</button>
          </span>
        </div>
        <div id="session-list" class="session-list"></div>
      </div>
    </div>

    <!-- Shown before the OS file dialog: the dialog can't be annotated and won't
         open ~/.claude/projects on its own, so spell out how to get there. -->
    <div id="picker-help" class="modal">
      <div class="modal-panel">
        <div class="modal-head">
          <span data-i18n="pickerTitle">Point zoetrope at your sessions</span>
          <button id="help-close" class="modal-x" title="Close" data-i18n-title="closeTitle">✕</button>
        </div>
        <div class="help-body">
          <p>
            <span data-i18n="pickerLive">Your Claude sessions live in</span>
            <code id="claude-path">~/.claude/projects</code>
            <button id="copy-path" class="copy-btn" title="Copy the path" data-i18n-title="copyTitle" data-i18n="copy">copy</button>
          </p>
          <p class="help-dim" data-i18n="pickerHint">The file dialog won't open that folder for you, so:</p>
          <ol class="help-steps" data-i18n-html="pickerSteps">
            <li><b>macOS:</b> press <kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>G</kbd>, paste the path, then <kbd>return</kbd>.</li>
            <li><b>Windows / Linux:</b> press <kbd>Ctrl</kbd> <kbd>L</kbd>, or type the path in the location bar.</li>
            <li>Pick the <b>projects</b> folder, or a single project inside it.</li>
          </ol>
          <div class="help-actions">
            <button id="help-open" class="act primary" data-i18n="openPicker">Open the file picker →</button>
            <button id="help-cancel" class="act" data-i18n="cancel">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <script is:inline type="module">
      import init, { zoetrope_load, zoetrope_append, zoetrope_set_lang } from '/wasm/web.js';

      const statusEl = document.getElementById('status');
      const dropEl = document.getElementById('drop');
      const dirInput = document.getElementById('dir-input');
      const openFolderBtn = document.getElementById('open-folder');
      const resetBtn = document.getElementById('reset');
      const sessionModal = document.getElementById('session-modal');
      const sessionList = document.getElementById('session-list');
      const sessionClose = document.getElementById('session-close');
      const sessionHead = document.getElementById('session-head');
      const sessionRefolder = document.getElementById('session-refolder');
      const pickerHelp = document.getElementById('picker-help');
      const helpOpen = document.getElementById('help-open');
      const helpCancel = document.getElementById('help-cancel');
      const helpClose = document.getElementById('help-close');
      const copyPath = document.getElementById('copy-path');
      const langBtn = document.getElementById('lang');

      // ── i18n ────────────────────────────────────────────────────────────
      // Every user-visible string on this page (the toolbar, the modals, the
      // status messages below), one table per language. The in-canvas TUI
      // (the wasm app) localizes itself: we hand it the language via
      // `zoetrope_set_lang`, and the `L` key cycles it there too.
      // Templates use {placeholders}, expanded by fmt().
      const STRINGS = {
        en: {
          docTitle: 'zoetrope — browser app',
          loading: 'loading wasm…',
          sessions: 'Sessions',
          sessionsTitle: 'Browse your Claude sessions and replay or follow one live.',
          demo: 'Demo',
          demoTitle: 'Reload the bundled demo session',
          dropHint:
            'Drop a session\'s <uuid>.jsonl here (with its <uuid>/ folder for subagents) to replay it, or use “Sessions” to browse your Claude projects.',
